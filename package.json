{
  "name": "utils",
  "private": true,
  "type": "module",
  "version": "6.0.0",
  "description": "Monorepo for shared utilities across IM Apps projects",
  "repository": {
    "type": "git",
    "url": "https://github.com/igor-siergiej/utils.git"
  },
  "packageManager": "bun@1.3.13",
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.json": "oxfmt"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "lint": "bun run build:config && oxlint && oxfmt --check",
    "lint:fix": "bun run build:config && oxlint --fix && oxfmt && oxlint",
    "format": "bun run build:config && oxfmt",
    "prepare": "husky",
    "release": "bunx semantic-release",
    "release:dry": "bunx semantic-release --dry-run --no-ci",
    "build:config": "turbo run build --filter=@imapps/oxc-config"
  },
  "devDependencies": {
    "@imapps/oxc-config": "*",
    "@oxlint/plugins": "1.90.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.2.0",
    "tsup": "^8.3.0",
    "turbo": "^2.9.14",
    "typescript": "^5.6.3"
  }
}
